{
  "expo": {
    "name": "SystemLife",
    "slug": "SystemLife",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "systemlife",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "extra": {
      "googleClientId": "${EXPO_PUBLIC_GOOGLE_CLIENT_ID}",
      "googleIosClientId": "${EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID}",
      "googleAndroidClientId": "${EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID}",
      "BACKEND_URL": "${EXPO_PUBLIC_BACKEND_URL}"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.name.SystemLife",
      "usesAppleSignIn": true,
      "icon": "./assets/adaptive-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.johannawirell.systemlife",
      "icon": "./assets/adaptive-icon.png"
    },
    "plugins": [
      "react-native-health"
    ]
  }
}
