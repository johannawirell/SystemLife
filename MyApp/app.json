{
  "expo": {
    "name": "SystemLife",
    "slug": "SystemLife",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "systemlife",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "extra": {
      "googleClientId": "${EXPO_PUBLIC_GOOGLE_CLIENT_ID}",
      "googleIosClientId": "${EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID}",
      "googleAndroidClientId": "${EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID}",
      "BACKEND_URL": "http://localhost:4000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.johannawirell.systemlife",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.johannawirell.systemlife"
    }
  }
}
